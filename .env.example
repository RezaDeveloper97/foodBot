# --- Required (always) ---
SPOONACULAR_API_KEY=your_spoonacular_key
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHANNEL_ID=@your_channel_username

# --- AI provider ---
# Pick ONE: gemini | groq | anthropic
# Only the key matching the chosen provider must be set; the others are ignored,
# so you can keep all three filled in and switch by changing AI_PROVIDER alone.
AI_PROVIDER=gemini

# Google AI Studio key (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key
# Groq Cloud key (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key
# Anthropic key (paid): https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key

# Model override. Leave empty to use the provider's default:
#   gemini    -> gemini-2.0-flash
#   groq      -> llama-3.3-70b-versatile
#   anthropic -> claude-sonnet-4-5
AI_MODEL=
AI_MAX_TOKENS=1500

# --- Scheduling (standard 5-field cron) ---
# Fetch a fresh batch: 03:00 every Monday
FETCH_CRON=0 3 * * 1
# Publish one recipe: 12:00 and 20:00 every day
PUBLISH_CRON=0 12,20 * * *

# --- Tuning (optional, sensible defaults) ---
FETCH_BATCH_SIZE=10
DB_PATH=data/store.json
IMAGE_DIR=data/images
PROMPT_PATH=prompt.txt
