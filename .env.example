# --- Required (always) ---
SPOONACULAR_API_KEY=0c3dac1a5d364d72b18d0212625d51d1
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHANNEL_ID=@your_channel_username

# --- AI provider ---
# Pick ONE: gemini | groq | anthropic
# Only the key matching the chosen provider must be set; the others are ignored,
# so you can keep all three filled in and switch by changing AI_PROVIDER alone.
AI_PROVIDER=gemini

# Google AI Studio key (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key
# Groq Cloud key (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key
# Anthropic key (paid): https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key

# Model override. Leave empty to use the provider's default:
#   gemini    -> gemini-2.0-flash
#   groq      -> llama-3.3-70b-versatile
#   anthropic -> claude-sonnet-4-5
AI_MODEL=
AI_MAX_TOKENS=1500
# Sampling temperature. Keep low (0.2–0.4) for translation/localization
# so the model picks real Persian words instead of inventing them.
AI_TEMPERATURE=0.3

# --- Scheduling (standard 5-field cron) ---
# Fetch a fresh batch: 03:00 every Monday
FETCH_CRON=0 3 * * 1
# Publish one recipe: 12:00 and 20:00 every day
PUBLISH_CRON=0 12,20 * * *
# Poll in-progress Anthropic batches (batch mode only). Every 10 minutes is
# plenty — batches usually finish in a few minutes but can take up to 24h.
BATCH_POLL_CRON=*/10 * * * *

# --- Batch mode (anthropic only) ---
# When true, FETCH_CRON submits a Messages Batch instead of doing per-recipe
# sync calls, BATCH_POLL_CRON ingests results when they arrive, and the
# publisher picks ready rows off the queue as usual. 50% cheaper than sync.
# Requires AI_PROVIDER=anthropic.
AI_BATCH_MODE=false

# --- Tuning (optional, sensible defaults) ---
FETCH_BATCH_SIZE=10
IMAGE_DIR=data/images
PROMPT_PATH=prompt.txt

# --- MySQL ---
# Run `./recipe-bot -migrate` once to auto-create the database and tables.
# The schema is utf8mb4 (Persian + emoji safe) and fully normalized:
# recipes / recipe_ingredients / recipe_steps / publish_log.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=recipe_bot
